<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GetANNY.Setup.ViewModels"
                    xmlns:v="clr-namespace:GetANNY.Setup.Views">

    <v:VisibleWhenConverter x:Key="VisibleWhen" />
    <v:InverseBoolConverter x:Key="Not" />
    <v:FractionToPercentConverter x:Key="Percent" />

    <!-- Shared page scaffold: 40px side gutters, footer pinned to the bottom. -->
    <Thickness x:Key="Page.Padding">40,20,40,28</Thickness>
    <Thickness x:Key="Footer.Margin">0,24,0,0</Thickness>

    <!-- Horizontal lockup at a fixed cap height; source bitmap is 2400×444 and is only scaled, never altered. -->
    <Style x:Key="Brand.Lockup" TargetType="Image">
        <Setter Property="Source" Value="pack://application:,,,/Assets/brand/lockup-horizontal-white.png" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="AutomationProperties.Name" Value="GetANNY" />
    </Style>

    <!-- Minimal success mark: 1px ring + check, white on black. -->
    <ControlTemplate x:Key="SuccessMark">
        <Grid Width="40" Height="40">
            <Ellipse Stroke="{StaticResource Brush.Text}" StrokeThickness="1" />
            <Path Data="M12,20.5 L17.5,26 L28,14.5" Stroke="{StaticResource Brush.Text}" StrokeThickness="1.75"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Grid>
    </ControlTemplate>

    <!-- ═══════════════════════ Installer · 1 · Welcome ═══════════════════════ -->
    <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
        <Grid Margin="{StaticResource Page.Padding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="320" Height="180" Background="{StaticResource Brush.Background}" HorizontalAlignment="Center"
                    Margin="0,0,0,8" AutomationProperties.Name="Animated GetANNY logo">
                <v:AnimatedGifImage ResourceUri="pack://application:,,,/Assets/brand/getanny-logo-animation.gif"
                                    Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="GetANNY animated logo" />
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left" Margin="0,8,0,8">
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Description}" Margin="0,10,0,0" MaxWidth="440" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Version}" Margin="0,14,0,0" />

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,24,0,0"
                        Visibility="{Binding ExistingNote, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding ExistingNote}" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,24,0,0"
                        Visibility="{Binding PayloadError, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding PayloadError}" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="{StaticResource Footer.Margin}">
                <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           Text="Per-user install · no administrator rights" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="_Install" Command="{Binding InstallCommand}" IsDefault="True" MinWidth="120" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ═══════════════════════ Installer · 2 · Options ═══════════════════════ -->
    <DataTemplate DataType="{x:Type vm:OptionsViewModel}">
        <Grid Margin="{StaticResource Page.Padding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding ScopeNote}" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,26,0,0">
                <TextBlock Style="{StaticResource Text.Label}" Text="DESTINATION FOLDER" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destination folder"
                             AutomationProperties.HelpText="Full path where GetANNY will be installed" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="_Browse…" Command="{Binding BrowseCommand}" Margin="10,0,0,0" MinWidth="100" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Validation}" Foreground="{StaticResource Brush.Text}"
                               Visibility="{Binding HasValidation, Converter={StaticResource VisibleWhen}}" />
                    <Button HorizontalAlignment="Right" Command="{Binding ResetCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Padding="0" Focusable="True" FocusVisualStyle="{StaticResource Focus.Outline}"
                            Visibility="{Binding IsDefaultDirectory, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                            AutomationProperties.Name="Reset to default folder">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Reset to default" TextDecorations="Underline" Foreground="{StaticResource Brush.TextSecondary}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock Style="{StaticResource Text.Label}" Text="SHORTCUTS" Margin="0,24,0,0" />
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,4">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding DesktopShortcut}" Content="Create a Desktop shortcut" Padding="0" Margin="0,12" />
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" />
                        <CheckBox IsChecked="{Binding StartMenuShortcut}" Content="Add GetANNY to the Start Menu" Margin="0,12" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="{StaticResource Footer.Margin}">
                <Button Style="{StaticResource Button.Secondary}" Content="_Back" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
                <Button Style="{StaticResource Button.Primary}" Content="_Install" Command="{Binding InstallCommand}" IsDefault="True" HorizontalAlignment="Right" MinWidth="120" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ═══════════════════════ Installer / Uninstaller · Progress ═══════════════════════ -->
    <DataTemplate DataType="{x:Type vm:ProgressViewModel}">
        <Grid Margin="{StaticResource Page.Padding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Subtitle}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Live status + bar. Determinate only when a stage reports measured bytes. -->
            <StackPanel Grid.Row="1" Margin="0,22,0,0" AutomationProperties.LiveSetting="Polite">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,120,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding StageCounter}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Margin="0,10,0,0" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Value="{Binding Fraction, Mode=OneWay, Converter={StaticResource Percent}}"
                             AutomationProperties.Name="{Binding Status}" />
            </StackPanel>

            <!-- Stage checklist -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="4,6">
                <ItemsControl ItemsSource="{Binding Stages}" Focusable="False" AutomationProperties.Name="Steps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageItemViewModel}">
                            <Grid Height="30" Margin="12,0" AutomationProperties.Name="{Binding AccessibleText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Indicator: dot (pending/active), check (done), dash (skipped), cross (failed) -->
                                <Grid Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Brush.BorderStrong}" />
                                    <Path x:Name="Check" Data="M2,7.5 L5.5,11 L12,3.5" Stroke="{StaticResource Brush.Text}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                                    <Path x:Name="Dash" Data="M3,7 H11" Stroke="{StaticResource Brush.TextTertiary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                    <Path x:Name="Cross" Data="M3,3 L11,11 M11,3 L3,11" Stroke="{StaticResource Brush.Text}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                </Grid>

                                <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                           Margin="16,0,0,0" MaxWidth="240" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Text}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="Pulse">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="Pulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Footer: error (if any) + actions -->
            <Grid Grid.Row="3" Margin="{StaticResource Footer.Margin}">
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Error}" Margin="0,0,0,14" AutomationProperties.LiveSetting="Assertive" />
                    <Grid>
                        <Button Style="{StaticResource Button.Secondary}" Content="View _log" Command="{Binding OpenLogCommand}" HorizontalAlignment="Left" />
                        <Button Style="{StaticResource Button.Primary}" Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" IsDefault="True" MinWidth="120" />
                    </Grid>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                           Text="Please keep this window open. Press Esc to cancel." />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ═══════════════════════ Installer · 4 · Complete ═══════════════════════ -->
    <DataTemplate DataType="{x:Type vm:CompleteViewModel}">
        <Grid Margin="{StaticResource Page.Padding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Style="{StaticResource Brand.Lockup}" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="520">
                <Control Template="{StaticResource SuccessMark}" HorizontalAlignment="Left" Focusable="False" AutomationProperties.Name="Success" />
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" Margin="0,20,0,0" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" Margin="0,10,0,0" />
                <CheckBox IsChecked="{Binding LaunchApp}" Content="Launch GetANNY" Margin="0,26,0,0" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="{StaticResource Footer.Margin}">
                <Button Style="{StaticResource Button.Primary}" Content="_Finish" Command="{Binding FinishCommand}" IsDefault="True" HorizontalAlignment="Right" MinWidth="120" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ═══════════════════════ Uninstaller · 1 · Confirm ═══════════════════════ -->
    <DataTemplate DataType="{x:Type vm:UninstallConfirmViewModel}">
        <Grid Margin="{StaticResource Page.Padding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <Border Width="208" Height="117" Background="{StaticResource Brush.Background}" HorizontalAlignment="Center"
                        AutomationProperties.Name="Animated GetANNY logo">
                    <v:AnimatedGifImage ResourceUri="pack://application:,,,/Assets/brand/getanny-logo-animation.gif"
                                        Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        AutomationProperties.Name="GetANNY animated logo" />
                </Border>
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" Margin="0,14,0,0" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding VersionLine}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding LocateError}" Margin="0,12,0,0" Visibility="{Binding LocateError, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0" Visibility="{Binding CanUninstall, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="WILL BE REMOVED" />
                            <ItemsControl ItemsSource="{Binding WillRemove}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" Margin="0,3" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="WILL BE KEPT" />
                            <ItemsControl ItemsSource="{Binding WillKeep}" Margin="0,8,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding}" Margin="0,3" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <CheckBox IsChecked="{Binding RemoveAppData}" Margin="0,18,0,0" AutomationProperties.HelpText="{Binding DataNote}">
                    <StackPanel>
                        <TextBlock Text="Also remove application data" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DataNote}" Margin="0,3,0,0" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>

            <Grid Grid.Row="2" Margin="{StaticResource Footer.Margin}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}" Content="_Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" IsCancel="False" />
                    <Button Style="{StaticResource Button.Primary}" Content="_Uninstall" Command="{Binding UninstallCommand}" MinWidth="120" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ═══════════════════════ Uninstaller · 3 · Complete ═══════════════════════ -->
    <DataTemplate DataType="{x:Type vm:UninstallCompleteViewModel}">
        <Grid Margin="{StaticResource Page.Padding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Style="{StaticResource Brand.Lockup}" Margin="0,6,0,0" />
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="520">
                <Control Template="{StaticResource SuccessMark}" HorizontalAlignment="Left" Focusable="False" AutomationProperties.Name="Done" />
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" Margin="0,20,0,0" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" Margin="0,10,0,0" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="{StaticResource Footer.Margin}">
                <Button Style="{StaticResource Button.Primary}" Content="_Finish" Command="{Binding FinishCommand}" IsDefault="True" HorizontalAlignment="Right" MinWidth="120" />
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
