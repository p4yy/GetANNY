{
  "name": "getanny",
  "version": "2.6.0",
  "description": "GetANNY Download Manager for Windows: manage file, media, torrent and browser downloads.",
  "main": "src/main/main.js",
  "author": "GetANNY Team",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run welcome:prepare && concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "node scripts/dev-web.js",
    "welcome:prepare": "node scripts/prepare-welcome-motion.js",
    "build:renderer": "npm run welcome:prepare && vite build",
    "build-extension": "node scripts/build-extension.js",
    "verify:branding": "node scripts/brand/verify-rendered-official-assets.js",
    "download-ytdlp": "node scripts/download-ytdlp.js",
    "prepare:tools": "node scripts/prepare-tools.js",
    "build:browser-bridge": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-native-host.ps1",
    "build:setup-ui": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-setup-ui.ps1",
    "build:win:candidate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-local-candidate.ps1",
    "build": "npm run build-extension && npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "build:win": "npm run build:browser-bridge && npm run verify:branding && npm run build-extension && npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "build:win:store": "node -e \"console.error('Microsoft Store package disabled until the owner tests and approves the 2.6.0 Windows Setup EXE.'); process.exit(1)\"",
    "build:linux": "npm run build-extension && npm run build:renderer && electron-builder --linux --publish never",
    "dist": "npm run build:win",
    "test": "node --test --test-concurrency=1 tests/*.test.js src/main/**/*.test.js",
    "test:ui": "node scripts/test-ui.js",
    "test:selection-ui": "node scripts/test-download-selection.js",
    "audit:locales": "node scripts/verify-locale-coverage.js",
    "format": "prettier --write src scripts tests docs README.md electron-builder.yml .github/workflows/*.yml",
    "postinstall": "electron-builder install-app-deps",
    "preview": "vite preview --host 0.0.0.0",
    "test:large-http": "node scripts/test-large-transfer.js"
  },
  "dependencies": {
    "basic-ftp": "6.2.6",
    "better-sqlite3": "^13.0.3",
    "content-disposition": "^0.5.4",
    "electron-updater": "^6.8.9",
    "megajs": "1.3.10",
    "webtorrent": "^3.0.21",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "selenium-webdriver": "4.50.0",
    "vite": "^6.4.1",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "overrides": {
    "ip": "npm:@webpod/ip@^0.6.1"
  },
  "homepage": "https://github.com/p4yy/GetANNY-Download-Manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p4yy/GetANNY-Download-Manager.git"
  },
  "keywords": [
    "download-manager",
    "electron",
    "windows",
    "yt-dlp",
    "ffmpeg",
    "browser-extension"
  ]
}
